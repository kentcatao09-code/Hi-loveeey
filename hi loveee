  <style>
    :root{
      --bg:#050505;
      --card:rgba(255,255,255,.06);
      --text:#f5f5f5;
      --pink:#ff77aa;
      --pink2:#ff4d8d;
      --muted:#d7d7d7;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      min-height:100vh;
      font-family:Arial, Helvetica, sans-serif;
      background:
        radial-gradient(circle at top, rgba(255,119,170,.15), transparent 35%),
        radial-gradient(circle at bottom, rgba(255,77,141,.12), transparent 30%),
        var(--bg);
      color:var(--text);
      overflow-x:hidden;
    }
    .wrap{
      max-width:900px;
      margin:0 auto;
      padding:32px 18px 60px;
      text-align:center;
      position:relative;
      z-index:2;
    }
    h1{
      margin:18px 0 10px;
      font-size:clamp(2rem, 5vw, 3.6rem);
      color:var(--pink);
      text-shadow:0 0 18px rgba(255,119,170,.25);
      animation:fadeInUp .9s ease both;
    }
    .subtitle{
      margin:0 auto 26px;
      max-width:720px;
      line-height:1.7;
      color:var(--muted);
      font-size:clamp(1rem, 2.5vw, 1.1rem);
      animation:fadeInUp 1.1s ease both;
    }
    .card{
      margin:0 auto;
      max-width:760px;
      background:var(--card);
      border:1px solid rgba(255,255,255,.08);
      border-radius:28px;
      padding:28px 20px;
      box-shadow:0 20px 60px rgba(0,0,0,.35);
      backdrop-filter:blur(10px);
      animation:fadeInUp 1.3s ease both;
    }
    .btn{
      appearance:none;
      border:0;
      border-radius:999px;
      padding:16px 28px;
      font-size:1.05rem;
      font-weight:700;
      color:#fff;
      background:linear-gradient(135deg, var(--pink), var(--pink2));
      box-shadow:0 12px 30px rgba(255,77,141,.35);
      cursor:pointer;
      transition:.2s transform ease, .2s opacity ease;
    }
    .btn:active{transform:scale(.98)}
    .btn.hidden{display:none}
    .message{
      display:none;
      margin-top:24px;
      text-align:left;
      line-height:1.9;
      font-size:1.04rem;
      color:#f3f3f3;
      white-space:pre-wrap;
    }
    .message.show{display:block; animation:fadeIn 1s ease both}
    .tiny{
      margin-top:14px;
      font-size:.92rem;
      color:#cfcfcf;
      opacity:.9;
    }
    .heart{
      position:fixed;
      bottom:-40px;
      font-size:20px;
      opacity:.8;
      pointer-events:none;
      animation:floatUp linear forwards;
      z-index:1;
      filter:drop-shadow(0 0 6px rgba(255,119,170,.4));
    }
    .music-note{
      font-size:2rem;
      margin-bottom:10px;
      display:inline-block;
      animation:pulse 1.6s ease-in-out infinite;
    }
    .reveal{
      margin-top:18px;
      padding:16px;
      border-radius:20px;
      border:1px dashed rgba(255,119,170,.35);
      color:#ffd9e6;
      background:rgba(255,119,170,.08);
      display:none;
    }
    .reveal.show{display:block; animation:fadeIn .8s ease both}

    @keyframes fadeInUp{
      from{opacity:0; transform:translateY(16px)}
      to{opacity:1; transform:translateY(0)}
    }
    @keyframes fadeIn{
      from{opacity:0}
      to{opacity:1}
    }
    @keyframes pulse{
      0%,100%{transform:scale(1)}
      50%{transform:scale(1.1)}
    }
    @keyframes floatUp{
      from{transform:translateY(0) scale(1); opacity:.9}
      to{transform:translateY(-110vh) scale(1.6); opacity:0}
    }
  </style>
</head>
